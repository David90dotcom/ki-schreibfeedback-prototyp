# Allgemeine Anwendung
APP_NAME=KI-Schreibfeedback-Prototyp

# Betriebsmodus: local, lan_https oder production
APP_MODE=local

# Prüferkonto und Sitzung
# AUTH_PASSWORD_HASH enthält ausschließlich einen Argon2-Hash,
# niemals das Klartextpasswort.
AUTH_USERNAME=pruefer
AUTH_PASSWORD_HASH=
SESSION_SECRET=
SESSION_MAX_AGE_SECONDS=3600

# Höchstens fünf fehlgeschlagene Anmeldungen je fünf Minuten.
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Lokaler Ollama-Provider
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=mistral-small3.2:24b-instruct-2506-q8_0
# Maximale Wartezeit je Modellaufruf. Zwei-Pass nutzt zwei Aufrufe.
OLLAMA_REQUEST_TIMEOUT_SECONDS=600

# OpenAI-Cloudprovider
# Den echten API-Key ausschließlich in die lokale .env-Datei eintragen.
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-5.6-luna
# Festes starkes Referenzmodell für die optionale Meta-Vorbewertung.
OPENAI_EVALUATION_MODEL=gpt-5.6-sol

# Mistral-Cloudprovider
# Den echten API-Key ausschließlich in die lokale .env-Datei eintragen.
MISTRAL_API_KEY=
MISTRAL_DEFAULT_MODEL=mistral-small-latest

# RunPod Serverless
# Diese Werte werden ausschließlich vom FastAPI-Backend verwendet.
# API-Key und Endpoint-IDs niemals in Browsercode oder Git eintragen.
RUNPOD_API_KEY=
# Standard-Endpoint für Mistral Small 3.2 24B FP8 mit einem
# automatischen 48-GB-GPU-Pool.
RUNPOD_ENDPOINT_ID=
# Zusätzliche feste Vergleichs-Endpoints.
# Für das 25,8-GB-FP8-Modell nicht geeignet; in Version 1.0 leer lassen.
RUNPOD_ENDPOINT_RTX4090_ID=
RUNPOD_ENDPOINT_RTX5090_ID=
RUNPOD_ENDPOINT_RTX6000_ADA_ID=
RUNPOD_DEFAULT_MODEL=RedHatAI/Mistral-Small-3.2-24B-Instruct-2506-FP8

# Maximale App-Wartezeit einschließlich Queue und Cold Start.
# Das Ausführungslimit des RunPod-Endpoints wird separat konfiguriert.
RUNPOD_JOB_TIMEOUT_SECONDS=1200
RUNPOD_POLL_INTERVAL_SECONDS=1

# Muss in der RunPod-Konsole bei allen Vergleichs-Endpoints ebenfalls
# als Idle timeout gesetzt werden. 3600 Sekunden sind das Maximum.
RUNPOD_IDLE_TIMEOUT_SECONDS=3600

# Modellkatalog und lokale Messwertdatenbank
MODEL_CATALOG_PATH=config/models.yaml
ANALYSIS_DATABASE_PATH=data/analysis_runs.sqlite3

# Eingabegrenzen
MAX_INPUT_CHARS=8000
MAX_CRITERIA=100
MAX_CRITERION_CHARS=10000

# Reproduzierbare Versionen
DEFAULT_PROMPT_VERSION=feedback-v1
DEFAULT_CRITERIA_VERSION=criteria-v1

# Speicherung technischer Messwerte
METRICS_PERSISTENCE_ENABLED=true
